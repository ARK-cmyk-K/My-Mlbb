# Supabase connection for the MLBB Showcase admin dashboard (task 02-01).
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project: Dashboard -> Project Settings -> API.
#
# Only the public project URL and the public `anon` key are used by the app.
# NEVER put the `service_role` key in a NEXT_PUBLIC_* variable: everything
# prefixed with NEXT_PUBLIC_ is shipped to the browser. Authorization is
# enforced in the database (RLS + public.is_admin()), never by this key.
#
# When these are absent the dashboard fails closed: every /admin request is
# redirected to /login and no privileged data is read.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
